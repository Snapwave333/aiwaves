{
  "name": "aiwaves-desktop",
  "productName": "AIWaves",
  "version": "0.1.0",
  "description": "AIWaves desktop: the agent-first DAW's read-only workspace, with its server built in",
  "main": "main.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.aiwaves.desktop",
    "productName": "AIWaves",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "build/icon.png",
      "splash/**"
    ],
    "extraResources": [
      {
        "from": "../backend/target/release/aiwaves.exe",
        "to": "bin/aiwaves.exe"
      },
      {
        "from": "../frontend/dist/frontend/browser",
        "to": "frontend"
      },
      {
        "from": "../engines",
        "to": "engines",
        "filter": [
          "**/*.py",
          "**/*.json"
        ]
      },
      {
        "from": "../fixtures",
        "to": "fixtures"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "AIWaves-${version}-portable.exe"
    }
  }
}
